# Required for make demo / live agent runs. Tests do not need a real key.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Local SQLite database (created automatically on seed).
DATABASE_URL=sqlite:///./data/demo.db

# Set to false to classify/investigate/reply without executing mutating tools.
AUTO_REMEDIATE=true
